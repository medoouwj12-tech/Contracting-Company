# Neon Auth URL (public URL may be shared with the browser)
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.neon.tech/your-database/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-endpoint.neon.tech/your-database/auth

# Neon Data API URL. Enable the Neon Data API for the same branch/database.
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-neon-data-api-endpoint.neon.tech/your-database/rest/v1

# Server-only signing secret, at least 32 characters. Generate a unique value.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Direct Postgres URL for migrations and admin tasks only; never expose with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
